---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SourceAttribution from '../components/SourceAttribution.astro';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource-variable/open-sans';
import '../styles/global.css';
import poppins600 from '@fontsource/poppins/files/poppins-latin-600-normal.woff2?url';
import poppins700 from '@fontsource/poppins/files/poppins-latin-700-normal.woff2?url';
import openSans from '@fontsource-variable/open-sans/files/open-sans-latin-wght-normal.woff2?url';

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  schema?: Record<string, any>[];
}

const props = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#05341c" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preload" as="font" type="font/woff2" href={openSans} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={poppins600} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={poppins700} crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="The Good Home List" href="/rss.xml" />
    <SEO {...props} path={path} />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <SourceAttribution />
    <!--
      Netlify Identity widget, loaded only when needed.

      CMS invite and password-recovery emails send people to the site root with a
      token in the URL fragment (#invite_token=..., #recovery_token=...). The
      widget has to run to catch that token and send the person on to /admin/.
      Visitors without one of those tokens never download the widget, which keeps a
      third-party script off every page view.
    -->
    <script is:inline>
      (function () {
        if (!/(?:^|[#&])(?:invite|recovery|confirmation|email_change|access)_token=/.test(location.hash)) return;
        var s = document.createElement('script');
        s.src = 'https://identity.netlify.com/v1/netlify-identity-widget.js';
        s.onload = function () {
          // After setting a password or logging in, continue to the CMS.
          if (window.netlifyIdentity) {
            window.netlifyIdentity.on('login', function () {
              document.location.href = '/admin/';
            });
          }
        };
        document.body.appendChild(s);
      })();
    </script>
  </body>
</html>
