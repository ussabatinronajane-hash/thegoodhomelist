---
// One route serves two kinds of page, because both live at /<category>/<slug>/:
//
//   /smart-home/best-smart-plugs/   a guide
//   /smart-home/cameras/            a subcategory listing
//
// Astro cannot tell them apart from the URL shape alone, so getStaticPaths
// builds both sets and tags each with `kind`. Keeping one route means guide
// URLs never gain an extra path segment, so nothing has to be redirected as
// the subcategory structure grows.

import { getCollection } from 'astro:content';
import PostView from '../../components/PostView.astro';
import SubcategoryView from '../../components/SubcategoryView.astro';
import { CATEGORIES, CATEGORY_MAP, SUBCATEGORIES } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);

  const postPaths = posts.map((post) => ({
    params: { category: post.data.category, slug: post.id },
    props: { kind: 'post' as const, post },
  }));

  // A subcategory only gets a page once something is filed under it. An empty
  // listing page is worse than no page: it wastes crawl budget and looks
  // abandoned to anyone who lands on it.
  const subPaths = CATEGORIES.flatMap((cat) =>
    (SUBCATEGORIES[cat.slug] ?? [])
      .map((sub) => ({
        sub,
        cat,
        items: posts
          .filter((p) => p.data.category === cat.slug && p.data.subcategory === sub.slug)
          .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
      }))
      .filter((x) => x.items.length > 0)
      .map((x) => ({
        params: { category: x.cat.slug, slug: x.sub.slug },
        props: { kind: 'sub' as const, cat: x.cat, sub: x.sub, posts: x.items },
      }))
  );

  // Fail the build rather than silently shadowing one page with the other.
  const seen = new Map<string, string>();
  for (const p of [...postPaths, ...subPaths]) {
    const key = `${p.params.category}/${p.params.slug}`;
    if (seen.has(key)) {
      throw new Error(
        `URL collision at /${key}/ — a guide and a subcategory share this slug. ` +
          `Rename one of them in src/content/posts or in SUBCATEGORIES in src/consts.ts.`
      );
    }
    seen.set(key, p.props.kind);
  }

  // Catch typos in post frontmatter early, where the message is useful.
  for (const post of posts) {
    const sub = post.data.subcategory;
    if (!sub) continue;
    const valid = (SUBCATEGORIES[post.data.category] ?? []).some((s) => s.slug === sub);
    if (!valid) {
      throw new Error(
        `"${post.id}" has subcategory "${sub}", which is not defined under ` +
          `"${post.data.category}" in SUBCATEGORIES in src/consts.ts.`
      );
    }
  }

  return [...postPaths, ...subPaths];
}

const props = Astro.props as any;
---
{props.kind === 'sub' ? (
  <SubcategoryView cat={props.cat} sub={props.sub} posts={props.posts} />
) : (
  <PostView post={props.post} />
)}
