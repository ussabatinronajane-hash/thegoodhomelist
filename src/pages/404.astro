---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MAIN_NAV } from '../consts';
---
<BaseLayout title="Page not found" description="That page does not exist." noindex={true}>
  <div class="wrap">
    <article class="read prose page-top">
      <h1>That Page Does Not Exist</h1>
      <p class="lede">The link may be old, or the page may have moved. Search for what you were after, or try one of these.</p>
      <ul>
        {MAIN_NAV.map((n) => <li><a href={n.href}>{n.name}</a></li>)}
        <li><a href="/">Homepage</a></li>
      </ul>
    </article>
  </div>
</BaseLayout>
