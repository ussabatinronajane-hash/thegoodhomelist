---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES } from '../consts';
---
<BaseLayout title="Page not found" description="That page does not exist." noindex={true}>
  <div class="wrap">
    <article class="read prose" style="padding-top:60px;">
      <h1>That page does not exist</h1>
      <p class="muted">The link may be old, or the page may have moved. Try one of these instead.</p>
      <ul>
        {CATEGORIES.map((c) => <li><a href={`/${c.slug}/`}>{c.name}</a></li>)}
        <li><a href="/">Homepage</a></li>
      </ul>
    </article>
  </div>
</BaseLayout>
