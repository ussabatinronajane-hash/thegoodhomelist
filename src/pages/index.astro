---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Img from '../components/Img.astro';
import LeafIcon from '../components/LeafIcon.astro';
import SectionIcon from '../components/SectionIcon.astro';
import PickRailCard from '../components/PickRailCard.astro';
import { SITE, CATEGORY_MAP, MAIN_NAV, ABOUT_IMAGE, ABOUT_IMAGE_ALT } from '../consts';
import { matchesRules } from '../lib/sections';
import { TOP_PICKS } from '../data/top-picks';

// Everything below comes from published guides. Nothing is invented, and a
// section with nothing to show is left out instead of filled with filler.
const all = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Hero: the newest featured guide, falling back to the newest guide.
const lead = all.find((p) => p.data.featured) ?? all[0];
// The four smaller stories under the hero: featured guides first, then the newest.
const rest = all.filter((p) => p !== lead);
const strip = [...rest.filter((p) => p.data.featured), ...rest.filter((p) => !p.data.featured)].slice(0, 4);
// Latest guides: the four newest, even if they also appear above.
const latest = all.slice(0, 4);

const tiles = MAIN_NAV.map((n) => {
  const newest = n.rules ? all.find((p) => matchesRules(n.rules, p.data) && p.data.image) : undefined;
  // A photo set on the section wins. Otherwise use the newest guide's image, which is decorative.
  return { ...n, photo: n.image || newest?.data.image || '', photoAlt: n.image ? (n.imageAlt ?? '') : '' };
});

const published = new Map(all.map((p) => [p.id, p]));
// Six picks, taken in turn from each guide so one guide does not fill the rail.
const byGuide = new Map<string, typeof TOP_PICKS>();
for (const p of TOP_PICKS.filter((p) => published.has(p.guide))) {
  byGuide.set(p.guide, [...(byGuide.get(p.guide) ?? []), p]);
}
const picks: typeof TOP_PICKS = [];
for (let i = 0; picks.length < 8 && [...byGuide.values()].some((g) => g.length > i); i++) {
  for (const g of byGuide.values()) if (g[i] && picks.length < 8) picks.push(g[i]);
}

const hrefOf = (p: any) => `/${p.data.category}/${p.id}/`;
const sectionName = (p: any) => MAIN_NAV.find((n) => matchesRules(n.rules, p.data))?.name ?? CATEGORY_MAP[p.data.category]?.name;
---
<BaseLayout
  title={`${SITE.name} | Practical, Stylish Home Finds`}
  description={SITE.description}
>
  <div class="home">
    <h1 class="sr-only">{SITE.name}: {SITE.tagline}</h1>

    {lead && (
      <section class="hero" aria-labelledby="hero-title">
        <div class="wrap">
          <div class="hero-copy">
            <span class="eyebrow-caps">Featured Guide</span>
            <h2 id="hero-title"><a href={hrefOf(lead)}>{lead.data.title}</a></h2>
            <p>{lead.data.excerpt}</p>
            <a href={hrefOf(lead)} class="btn btn-arrow">Read the Guide <span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>
        <div class="hero-media" aria-hidden="true">
          {lead.data.image ? (
            <Img src={lead.data.image} alt="" width={1200} height={800} sizes="(min-width: 1024px) 60vw, 100vw" loading="eager" fetchpriority="high" />
          ) : (
            <div class="ph"><LeafIcon /></div>
          )}
        </div>
      </section>
    )}

    {strip.length > 0 && (
      <section class="wrap strip-wrap" aria-label="More featured guides">
        <ul class={`strip strip-${strip.length}`}>
          {strip.map((p) => (
            <li class="strip-item">
              <a href={hrefOf(p)} class="strip-thumb" aria-hidden="true" tabindex="-1">
                {p.data.image ? (
                  <Img src={p.data.image} alt="" width={156} height={184} sizes="78px" />
                ) : (
                  <div class="ph"><LeafIcon /></div>
                )}
              </a>
              <div>
                <h3><a href={hrefOf(p)}>{p.data.title}</a></h3>
                <p>{p.data.excerpt}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="wrap" aria-labelledby="browse-title">
      <div class="panel">
        <div class="panel-head">
          <h2 id="browse-title">Browse by Category</h2>
        </div>
        <ul class="cat-tiles">
          {tiles.map((t) => (
            <li>
              <a href={t.href} class="cat-tile">
                <span class="cat-photo">
                  {t.icon === 'picks' && !t.photo ? (
                    <span class="picks-badge" aria-hidden="true"><span>Best<br />Picks</span></span>
                  ) : t.photo ? (
                    <Img src={t.photo} alt={t.photoAlt} width={320} height={240} sizes="(min-width: 1024px) 170px, 45vw" />
                  ) : (
                    <span class="ph"><SectionIcon name={t.icon} /></span>
                  )}
                </span>
                <span class="cat-label"><SectionIcon name={t.icon} />{t.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {latest.length > 0 && (
      <section class="wrap home-section" aria-labelledby="latest-title">
        <div class="section-head">
          <h2 id="latest-title">Latest Buying Guides</h2>
          <a class="view-all" href="/guides/">View All Guides <span aria-hidden="true">&rarr;</span></a>
        </div>
        <ul class="card-grid cols-4">
          {latest.map((post) => <PostCard post={post} />)}
        </ul>
      </section>
    )}

    {picks.length > 0 && (
      <section class="wrap home-section" aria-labelledby="picks-title">
        <div class="panel picks-panel">
          <div class="picks-intro">
            <h2 id="picks-title">Our Top Picks</h2>
            <p>
              Standout picks from our published guides. Each one links to the full write-up.
              &ldquo;Check Price&rdquo; buttons are affiliate links.
            </p>
            <a href="/best-picks/" class="btn btn-arrow">See All Top Picks <span aria-hidden="true">&rarr;</span></a>
          </div>
          <div class="rail-wrap">
            <button class="rail-arrow rail-prev" type="button" aria-label="Previous picks" hidden>&lsaquo;</button>
            <ul class="rail" tabindex="0" aria-label="Top picks">
              {picks.map((p) => <PickRailCard pick={p} category={published.get(p.guide)!.data.category} />)}
            </ul>
            <button class="rail-arrow rail-next" type="button" aria-label="Next picks" hidden>&rsaquo;</button>
          </div>
        </div>
      </section>
    )}

    <section class="about" aria-labelledby="about-title">
      <div class="about-media">
        {ABOUT_IMAGE ? (
          <Img src={ABOUT_IMAGE} alt={ABOUT_IMAGE_ALT} width={900} height={600} sizes="(min-width: 900px) 50vw, 100vw" />
        ) : (
          <div class="ph"><LeafIcon /></div>
        )}
      </div>
      <div class="about-copy">
        <span class="eyebrow-caps">About {SITE.name}</span>
        <h2 id="about-title">Practical, Stylish Finds for a Home That Works Beautifully.</h2>
        <p>
          We share well-researched product recommendations, buying guides, and home ideas to help
          you create a comfortable, organized, and beautiful home &mdash; without overspending.
        </p>
        <a href="/about/" class="btn btn-arrow">Learn More About Us <span aria-hidden="true">&rarr;</span></a>
      </div>
    </section>

    {all.length === 0 && (
      <section class="wrap home-section">
        <p class="muted">No guides published yet. Add one in the admin panel at <code>/admin</code> and it will appear here.</p>
      </section>
    )}
  </div>

  <script is:inline>
    // Arrows for the Top Picks rail. They stay hidden unless the cards overflow.
    (function () {
      var rail = document.querySelector('.rail');
      if (!rail) return;
      var prev = document.querySelector('.rail-prev');
      var next = document.querySelector('.rail-next');
      function update() {
        var overflow = rail.scrollWidth > rail.clientWidth + 4;
        prev.hidden = !overflow || rail.scrollLeft < 4;
        next.hidden = !overflow || rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 4;
      }
      function step(dir) {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        rail.scrollBy({ left: dir * rail.clientWidth * 0.8, behavior: reduce ? 'auto' : 'smooth' });
      }
      prev.addEventListener('click', function () { step(-1); });
      next.addEventListener('click', function () { step(1); });
      rail.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    })();
  </script>
</BaseLayout>
