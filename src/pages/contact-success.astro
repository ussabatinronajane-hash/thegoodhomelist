---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Message sent"
  description="Your message was sent successfully."
  noindex={true}
>
  <div class="wrap">
    <article class="read prose" style="padding-top:60px;">
      <h1>Message sent</h1>
      <p>Thanks for reaching out. I read everything and will get back to you shortly.</p>
      <p><a href="/">Back to the homepage</a></p>
    </article>
  </div>
</BaseLayout>
