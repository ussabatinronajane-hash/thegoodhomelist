---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { MAIN_NAV } from '../consts';
---
<BaseLayout
  title="Search Buying Guides"
  description="Search The Good Home List for buying guides, comparisons and product picks."
  noindex={true}
>
  <div class="wrap">
    <Breadcrumbs items={[{ label: 'Search' }]} />
    <div class="read">
      <h1>Search Buying Guides</h1>

      <p id="search-status" class="muted" role="status" aria-live="polite">Use the search box above. Try a word like &ldquo;storage&rdquo; or &ldquo;cutting board&rdquo; to search every published guide.</p>
      <ul id="search-results" class="search-results"></ul>

      <div id="search-browse">
        <p class="muted">Or browse by topic:</p>
        <ul class="subnav">
          {MAIN_NAV.map((n) => <li><a href={n.href}>{n.name}</a></li>)}
        </ul>
      </div>
      <noscript><p>Search needs JavaScript. Browse by topic above instead.</p></noscript>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var params = new URLSearchParams(location.search);
    var q = (params.get('q') || '').slice(0, 100).trim();
    var headerBox = document.getElementById('site-search');
    var pageBox = document.getElementById('page-search');
    if (headerBox) headerBox.value = q;
    if (pageBox) pageBox.value = q;

    var status = document.getElementById('search-status');
    var list = document.getElementById('search-results');
    var browse = document.getElementById('search-browse');

    // Lowercase, drop accents and punctuation, and trim a plural "s" so that
    // "boards" finds "board" and "décor" finds "decor".
    function norm(text) {
      return String(text)
        .toLowerCase()
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .replace(/&/g, ' and ')
        .replace(/[^a-z0-9\s]/g, ' ');
    }
    function stem(w) {
      return w.length > 3 && w.slice(-1) === 's' && w.slice(-2) !== 'ss' ? w.slice(0, -1) : w;
    }
    function tokens(text) {
      return norm(text).split(/\s+/).filter(Boolean).map(stem);
    }
    // Everyday words that would otherwise stop a natural question from matching.
    var STOP = ' a an the do does did my your our to how what why when which is are be for of in on and or i you it can should with ';
    function queryTerms(text) {
      var all = tokens(text);
      var kept = all.filter(function (t) { return STOP.indexOf(' ' + t + ' ') === -1; });
      return kept.length ? kept : all;
    }

    var terms = queryTerms(q);
    if (!terms.length) return;

    status.textContent = 'Searching…';
    fetch('/search.json')
      .then(function (r) {
        if (!r.ok) throw new Error('bad response');
        return r.json();
      })
      .then(function (items) {
        var phrase = terms.join(' ');
        function rank(requireAll) {
          var found = [];
          items.forEach(function (it) {
            var title = tokens(it.title);
            var meta = tokens(it.category + ' ' + it.topic);
            var body = tokens(it.excerpt);
            var faq = tokens(it.faq);
            var score = 0;
            var matched = 0;
            terms.forEach(function (t) {
              var hit = 0;
              if (title.indexOf(t) !== -1) hit += 6;
              if (meta.indexOf(t) !== -1) hit += 3;
              if (body.indexOf(t) !== -1) hit += 2;
              if (faq.indexOf(t) !== -1) hit += 1;
              if (hit) matched++;
              score += hit;
            });
            if (requireAll ? matched !== terms.length : matched === 0) return;
            if (terms.length > 1 && title.join(' ').indexOf(phrase) !== -1) score += 8;
            found.push({ it: it, score: score });
          });
          // Higher score first. Equal scores keep the index order, which is newest first.
          return found.sort(function (a, b) { return b.score - a.score; });
        }

        var scored = rank(true);
        var closest = false;
        // Nothing contains every word: fall back to guides that contain some of them.
        if (!scored.length && terms.length > 1) {
          scored = rank(false).slice(0, 5);
          closest = scored.length > 0;
        }

        var n = scored.length;
        if (n && closest) {
          status.textContent = 'No guide matches every word in \u201C' + q + '\u201D. Closest ' + (n === 1 ? 'match' : n + ' matches') + ':';
        } else if (n) {
          status.textContent = n + (n === 1 ? ' guide' : ' guides') + ' found for \u201C' + q + '\u201D';
        } else {
          status.textContent = 'No guides found for \u201C' + q + '\u201D. Try a shorter or more general word, or browse by topic below.';
        }
        if (n) browse.hidden = true;

        scored.slice(0, 20).forEach(function (s) {
          var it = s.it;
          var li = document.createElement('li');
          var h = document.createElement('h2');
          var a = document.createElement('a');
          a.href = it.url;
          a.textContent = it.title;
          h.appendChild(a);
          var meta = document.createElement('p');
          meta.className = 'card-meta';
          meta.textContent = it.category;
          var p = document.createElement('p');
          p.textContent = it.excerpt;
          li.appendChild(h);
          li.appendChild(meta);
          li.appendChild(p);
          list.appendChild(li);
        });
      })
      .catch(function () {
        status.textContent = 'Search is unavailable right now. Please try again later, or browse by topic below.';
      });
  })();
</script>
