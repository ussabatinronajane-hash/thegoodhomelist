---
export interface Props {
  /** Astro's `headings` from render(). */
  headings: { depth: number; slug: string; text: string }[];
  minHeadings?: number;
}

const { headings, minHeadings = 4 } = Astro.props;

// Only H2s. H3s make the list too noisy to scan, which defeats the purpose.
const items = headings.filter((h) => h.depth === 2);
const show = items.length >= minHeadings;
---
{show && (
  <aside class="toc-aside">
    <nav aria-label="Table of contents">
      <details class="toc" open>
        <summary>In This Guide</summary>
        <ol>
          {items.map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </details>
    </nav>
    <script is:inline>
      // Collapsed by default on small screens. Without JavaScript it stays open.
      (function () {
        var d = document.currentScript.parentElement.querySelector('details');
        if (d && window.matchMedia('(max-width: 999px)').matches) d.removeAttribute('open');
      })();
    </script>
  </aside>
)}
