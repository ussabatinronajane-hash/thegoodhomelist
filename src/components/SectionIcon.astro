---
// Small line icons for the six main sections.
export interface Props { name: 'kitchen' | 'decor' | 'organize' | 'garden' | 'smart' | 'picks' }
const { name } = Astro.props;
---
<svg class="section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'kitchen' && (<><path d="M4 11h16v6a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3z"/><path d="M8 11V8h8v3M10 5h4M2 13h2M20 13h2"/></>)}
  {name === 'decor' && (<><path d="M9 21h6M12 21v-5"/><path d="M8 16c-3-1-4-4-3-8 3 0 6 1 7 4 1-3 4-4 7-4 1 4 0 7-3 8z"/></>)}
  {name === 'organize' && (<><rect x="4" y="4" width="16" height="6" rx="1"/><rect x="4" y="14" width="16" height="6" rx="1"/><path d="M10 7h4M10 17h4"/></>)}
  {name === 'garden' && (<><path d="M12 21v-9"/><path d="M12 12C7 12 5 9 5 5c5 0 7 3 7 7z"/><path d="M12 15c0-3 2-5 6-5 0 4-2 6-6 5z"/></>)}
  {name === 'smart' && (<><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M9.5 14.5a3.5 3.5 0 0 1 5 0M8 12.5a6 6 0 0 1 8 0"/></>)}
  {name === 'picks' && (<><path d="M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.3 6.8 19.1l1-5.8L3.5 9.2l5.9-.9z"/></>)}
</svg>
