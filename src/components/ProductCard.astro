---
import { amazonUrl, AFFILIATE_ATTRS } from '../lib/amazon';
import Img from './Img.astro';
import ProsCons from './ProsCons.astro';

export interface Props {
  name: string;
  /** Bare ASIN or a full Amazon URL. Gets tagged automatically. */
  asin: string;
  /** e.g. "Best Overall", "Best Budget", "Best for Small Spaces" */
  badge?: string;
  /** One or two sentences on who this is for and why it wins. */
  verdict: string;
  /** Image URL. Use Amazon SiteStripe image links or your own photo. */
  image?: string;
  imageAlt?: string;
  pros?: string[];
  cons?: string[];
  ctaLabel?: string;
  /** What the pros and cons are based on, shown under them. */
  basis?: string;
}

const {
  name,
  asin,
  badge,
  verdict,
  image,
  imageAlt,
  pros = [],
  cons = [],
  ctaLabel = 'Check price on Amazon',
  basis,
} = Astro.props;

const href = amazonUrl(asin);
---
<div class="product">
  <div class="product-top">
    {image && (
      <div class="product-img">
        <Img src={image} alt={imageAlt ?? name} width={168} height={168} sizes="168px" />
      </div>
    )}
    <div class="product-body">
      {badge && <span class="product-badge">{badge}</span>}
      <h3>{name}</h3>
      <p class="product-verdict">{verdict}</p>

      <slot />
      <ProsCons pros={pros} cons={cons} basis={basis} />

      <a href={href} class="btn" {...AFFILIATE_ATTRS}>{ctaLabel}<span class="sr-only">: {name} (affiliate link)</span></a>
      <p class="btn-note">Price and availability change often. We link out so you always see the current one.</p>
    </div>
  </div>
</div>
