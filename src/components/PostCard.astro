---
import { CATEGORY_MAP } from '../consts';

export interface Props {
  post: any;
}
const { post } = Astro.props;
const cat = CATEGORY_MAP[post.data.category];
const href = `/${post.data.category}/${post.id}/`;
const date = (post.data.updatedDate ?? post.data.pubDate).toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric',
});
---
<li class="card">
  <a href={href} class="card-thumb" aria-hidden="true" tabindex="-1">
    {post.data.image && (
      <img src={post.data.image} alt="" width="560" height="350" loading="lazy" decoding="async" />
    )}
  </a>
  <span class="card-eyebrow">{cat?.name}</span>
  <h3><a href={href}>{post.data.title}</a></h3>
  <p>{post.data.excerpt}</p>
  <p class="card-meta">Updated {date}</p>
</li>
