---
import { CATEGORY_MAP, MAIN_NAV } from '../consts';
import { matchesRules } from '../lib/sections';
import LeafIcon from './LeafIcon.astro';
import Img from './Img.astro';

export interface Props {
  post: any;
}
const { post } = Astro.props;
// Label with the main section the guide belongs to, falling back to its category.
const section = MAIN_NAV.find((n) => matchesRules(n.rules, post.data));
const label = section?.name ?? CATEGORY_MAP[post.data.category]?.name;
const href = `/${post.data.category}/${post.id}/`;
const dateLabel = post.data.updatedDate ? 'Updated' : 'Published';
const date = (post.data.updatedDate ?? post.data.pubDate).toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric',
});
---
<li class="card">
  <a href={href} class="card-thumb" aria-hidden="true" tabindex="-1">
    {post.data.image ? (
      <Img src={post.data.image} alt="" width={560} height={350} sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 92vw" />
    ) : (
      <div class="ph"><LeafIcon /></div>
    )}
  </a>
  <div class="card-body">
    <span class="card-eyebrow">{label}</span>
    <h3><a href={href}>{post.data.title}</a></h3>
    <p class="card-excerpt">{post.data.excerpt}</p>
    <p class="card-meta">{dateLabel} {date}</p>
  </div>
</li>
