---
import { SITE, MAIN_NAV } from '../consts';
import BrandMark from './BrandMark.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a href="/" class="footer-brand">
          <BrandMark light />
          <span class="brand-name">{SITE.name}</span>
        </a>
        <p class="footer-about">{SITE.tagline}. Independent, researched buying guides with clear disclosure and no paid placements.</p>
      </div>
      <div>
        <h3>Categories</h3>
        <ul>
          {MAIN_NAV.map((n) => (
            <li><a href={n.href}>{n.name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h3>The Site</h3>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/editorial-policy/">How We Test</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </div>
      <div>
        <h3>Legal</h3>
        <ul>
          <li><a href="/affiliate-disclosure/">Affiliate Disclosure</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/cookie-policy/">Cookie Policy</a></li>
          <li><a href="/terms-and-conditions/">Terms and Conditions</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <!--
        Amazon requires this sentence word for word, on every page carrying
        affiliate links. Do not reword it or substitute the site name.
      -->
      <p>
        As an Amazon Associate, I earn from qualifying purchases. {SITE.name} is a participant in
        the Amazon Services LLC Associates Program, an affiliate advertising program designed to
        provide a means for sites to earn advertising fees by advertising and linking to
        Amazon.com. Prices and availability are accurate as of the date shown and are subject to
        change.
      </p>
      <p>&copy; {year} {SITE.name}. All rights reserved.</p>
    </div>
  </div>
</footer>
